# Server Port Configuration
PORT=5000

# MongoDB Connection URI (Local or Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# App Environment Mode
NODE_ENV=development

# Nodemailer / Gmail SMTP Configuration
# Gmail address used for authenticating and sending the emails
EMAIL_USER=botvortex.learning@gmail.com

# 16-character Google App Password (not the raw Gmail password)
# Generated via Google Account Settings -> Security -> 2-Step Verification -> App Passwords
EMAIL_PASS=mxcpztzhbyvbthvz

# Optional: Custom SMTP Server Configuration (Overrides Gmail settings if SMTP_HOST is set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
